{
  "name": "bmems",
  "version": "1.0.0",
  "private": true,
  "description": "Biomedical Equipment Maintenance & Fault Reporting System (BEM-FRS)",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run build && npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "reset": "npm run reset -w server",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
