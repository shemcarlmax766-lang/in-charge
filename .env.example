# ─────────────────────────────────────────────────────────────────────────────
# BEM-FRS configuration.  Copy to `.env` (git-ignored) and edit.
# Nothing here is required to boot: every value has a safe default, and no
# credential, key or password is ever committed.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Dev-server only (read by client/vite.config.js, not by the API):
# CLIENT_PORT overrides the Vite port; API_ORIGIN points its /api proxy at another backend.
CLIENT_PORT=5173
#API_ORIGIN=http://127.0.0.1:4000
# Behind nginx/Caddy: required so req.ip is the client, not the proxy.
TRUST_PROXY=0
# Absolute origin embedded in printed QR labels. Required in production,
# because a phone scanning a label is not on "localhost".
PUBLIC_BASE_URL=https://equipment.myschool.edu

# Native app shells (Capacitor APK/IPA) load the web build from a virtual origin and call the
# API cross-origin. List those origins here to enable CORS for them ONLY; leave unset and the
# API stays strictly same-origin (web). e.g. shells built against a LAN dev server:
#NATIVE_ORIGINS=https://localhost,http://localhost:8100

# Storage
DATA_DIR=./data
DATABASE_PATH=./data/bmems.sqlite
UPLOAD_DIR=./data/uploads

# Authentication
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_HOURS=336
MAX_FAILED_LOGIN_ATTEMPTS=6
LOGIN_LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12
# scrypt cost parameter; raise if the server has headroom (memory ~128*N*r KiB).
SCRYPT_N=16384

# Uploads
MAX_UPLOAD_MB=8
MAX_UPLOAD_FILES=5
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,application/pdf
UPLOAD_ALLOWED_EXT=.jpg,.jpeg,.png,.webp,.gif,.pdf,.txt,.csv,.docx

# Rate limits (per client, per minute)
RATE_MAX=300
LOGIN_RATE_MAX=12
WRITE_RATE_MAX=60
LIST_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Demo data — the seeder refuses to run against a database that already has users.
# If SEED_PASSWORD is unset the seeder generates a strong one and prints it once.
SEED_DEMO_DATA=1
#SEED_PASSWORD=change-me-to-a-long-passphrase

# Notification channels (in-app is always on; the others record a `skipped`
# delivery row until an adapter is implemented — see docs/INTEGRATIONS.md)
ENABLE_EMAIL_NOTIFY=0
ENABLE_SMS_NOTIFY=0
ENABLE_PUSH_NOTIFY=0

# --- Self-service onboarding & password recovery (docs/SECURITY.md §1.1) ---------
# Self sign-up may only create Reporter accounts; technicians/admins stay
# admin-provisioned. Set 0 to route everyone through the administrator.
ALLOW_SELF_REGISTRATION=1
RESET_CODE_TTL_MINUTES=15
RESET_MAX_ATTEMPTS=5
RESET_THROTTLE_SECONDS=60
# Demo convenience: echo the recovery code in the API response. Honoured ONLY on
# non-production builds without SMTP_HOST. Set 0 to disable it entirely.
REVEAL_OTP_IN_RESPONSE=1
# Recovery mail: set SMTP_HOST for nodemailer delivery (campus relay works — no
# auth needed if it accepts local submissions); without it, mails land as files
# in data/outbox/. See docs/INTEGRATIONS.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BEM-FRS <no-reply@localhost>
SMTP_TIMEOUT_MS=15000
